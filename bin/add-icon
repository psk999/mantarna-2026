#!/usr/bin/env bash
# Add Lucide icons (https://lucide.dev/icons) as Jekyll includes.
# Usage: bin/add-icon heart-pulse stethoscope ...   then in a page: {% include icon.html name="heart-pulse" %}
set -euo pipefail
cd "$(dirname "$0")/.."
LUCIDE_VERSION="0.525.0"
for name in "$@"; do
  out="_includes/icons/$name.svg"
  curl -fsSL "https://unpkg.com/lucide-static@$LUCIDE_VERSION/icons/$name.svg" \
    | sed -e '/^<!--/d' -e "s|<svg|<svg aria-hidden=\"true\" focusable=\"false\"|" -e 's/class="[^"]*"/class="lucide lucide-'"$name"'"/' \
    | tr -s ' \n' ' ' > "$out"
  echo "added $out"
done
