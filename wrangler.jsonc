{
  // Mantrana Healthcare website.
  // Static Jekyll output (_site/) served as Workers static assets; no Worker script.
  // Build first (bundle exec jekyll build) and run deploy/leak-scan.sh; Wrangler uploads _site/.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mantranahealthcare",
  "compatibility_date": "2026-10-01",
  // Custom domains: the mantranatech.ai zone must be active in the same Cloudflare account.
  // Wrangler creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "mantranatech.ai", "custom_domain": true },
    { "pattern": "www.mantranatech.ai", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
