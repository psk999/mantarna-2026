{
  // Mantrana Healthcare website.
  // Static Jekyll output (_site/) served as Workers static assets; no Worker script.
  // Build first (bundle exec jekyll build) and run deploy/leak-scan.sh; Wrangler uploads _site/.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mantrana-healthcare",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
