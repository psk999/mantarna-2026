---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | where_exp: "p", "p.sitemap != false" | where_exp: "p", "p.url contains '/'" | sort: "url" %}
{%- for p in pages %}{% unless p.url contains '.' and p.url != '/' %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <priority>{% if p.url == '/' %}1.0{% else %}0.8{% endif %}</priority>
  </url>
{%- endunless %}{% endfor %}
</urlset>
